# ── Artix/Dinit init system packages ──────────────────────────────────────
# dinit (from Artix system repo) provides the base init system
# elogind + dbus are Artix replacements for systemd-logind
# calamares is in Artix world repo (no need for endeavouros)
# sshd dinit service file is in our airootfs overlay (/etc/dinit.d/sshd)
dinit
elogind
dbus
calamares
artix-archlinux-support

# ── Dinit service packages (-dinit variants) ──────────────────────────────
# Artix ships separate -dinit packages that provide the service files
