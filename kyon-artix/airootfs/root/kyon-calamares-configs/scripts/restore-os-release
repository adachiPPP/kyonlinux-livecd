#!/usr/bin/env bash

# Restores Kyon's /etc/os-release identity in the installed system.
# ADAPTED FOR ARTIX/DINIT: reports artix-based instead of arch-based.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

os_release_file=/etc/os-release
usr_os_release=/usr/lib/os-release

{
    printf '%s\n' 'NAME="Kyon Linux"'
    printf '%s\n' 'PRETTY_NAME="Kyon Linux (Artix/Dinit)"'
    printf '%s\n' 'ID=artix-based'
    printf '%s\n' 'BUILD_ID=rolling'
    printf '%s\n' 'ANSI_COLOR="38;2;23;147;209"'
    printf '%s\n' 'HOME_URL="https://adachippp.github.io/kyonlinux/"'
    printf '%s\n' 'DOCUMENTATION_URL="https://adachippp.github.io/kyonlinux/"'
    printf '%s\n' 'SUPPORT_URL="https://adachippp.github.io/kyonlinux/"'
    printf '%s\n' 'BUG_REPORT_URL="https://adachippp.github.io/kyonlinux/"'
} > "$usr_os_release"
chmod 644 "$usr_os_release"

# /etc/os-release is normally the filesystem package's symlink to
# /usr/lib/os-release (which we just rewrote) - leave it alone to avoid
# replacing a package-owned symlink.
if [ ! -L "$os_release_file" ] && [ -e "$os_release_file" ]; then
    cp "$usr_os_release" "$os_release_file"
    chmod 644 "$os_release_file"
fi

exit 0
