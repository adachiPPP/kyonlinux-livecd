#!/usr/bin/env bash

# fix-boot-media - locate the boot media files for Ventoy / Rufus ISO mode / dd
#
# Standard archiso mounts the boot media at /run/archiso/bootmnt/ and places
# the squashfs at /run/archiso/bootmnt/<archisobasedir>/x86_64/airootfs.sfs.
# Ventoy, Rufus ISO mode, and some dd'd USB setups can make the live system
# boot without that exact path being present, even though the ISO is fully
# readable. This script locates airootfs.sfs (and vmlinuz-linux) wherever they
# are on the running system and creates the expected paths so that Calamares'
# unpackfs module can find them.
#
# This is NOT a substitute for writing the ISO correctly in the first place.
# If you used dd, make sure you wrote the whole device (not a partition) and
# ran sync afterwards; if the device is too small for the ISO, the end of the
# squashfs may be missing and no amount of searching will help.

set -euo pipefail

install_dir="arch"
arch="x86_64"

EXPECTED_SFS="/run/archiso/bootmnt/${install_dir}/${arch}/airootfs.sfs"
EXPECTED_VMLINUZ="/run/archiso/bootmnt/${install_dir}/boot/${arch}/vmlinuz-linux"

log() { printf 'fix-boot-media: %s\n' "$*" >&2; }

# ── 1. Find airootfs.sfs ──────────────────────────────────────────────────

# Likely locations relative to a mounted ISO tree. The live initramfs usually
# puts the boot media under /run/archiso/bootmnt/<archisobasedir>/, but Ventoy
# loopboot, Rufus ISO mode, and some dd setups may expose the ISO contents
# somewhere else, or only as a loopback file.
possible_sfs_basenames=(
    "airootfs.sfs"
    "filesystem.squashfs"
)

find_sfs() {
    # Already at the expected path?
    [ -f "$EXPECTED_SFS" ] && { echo "$EXPECTED_SFS"; return 0; }

    local found="" dir base

    # (a) Walk the usual archiso / Ventoy / Rufus mount points looking for any
    #     known squashfs name inside an <archisobasedir>/<arch>/ tree.
    for dir in /run/archiso/bootmnt /run/miso /run/media /mnt /media /run/archiso; do
        [ -d "$dir" ] || continue
        for base in "${possible_sfs_basenames[@]}"; do
            found=$(find "$dir" -maxdepth 6 -name "$base" -type f 2>/dev/null | head -1)
            [ -n "$found" ] && { echo "$found"; return 0; }
        done
    done

    # (b) Check every mounted filesystem from /proc/mounts. This catches Ventoy
    #     loop mounts, FUSE mounts, custom mount points, etc.
    while read -r _ mountpoint _ _ _ _; do
        case "$mountpoint" in
            /proc|/sys|/dev|/run/udev|/run/lock|/tmp) continue ;;
        esac
        [ -d "$mountpoint" ] || continue
        for base in "${possible_sfs_basenames[@]}"; do
            found=$(find "$mountpoint" -maxdepth 6 -name "$base" -type f 2>/dev/null | head -1)
            [ -n "$found" ] && { echo "$found"; return 0; }
        done
    done < /proc/mounts

    # (c) Broad search from / (skipping virtual filesystems).
    for base in "${possible_sfs_basenames[@]}"; do
        found=$(find / -path /proc -prune -o -path /sys -prune -o -path /dev -prune \
            -o -name "$base" -type f -print 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done

    # (d) Last resort: look for a vmlinuz-linux and then assume a sibling
    #     airootfs.sfs lives under the same <archisobasedir>/<arch>/ tree. This
    #     helps when the ISO was loopbooted (Ventoy) and the squashfs is under
    #     the mounted ISO's arch/ tree rather than the default bootmnt path.
    if [ -z "${SFS_FOUND:-}" ]; then
        local vmlinux=""
        vmlinux=$(find /run/archiso /run/miso /run/media /mnt /media /run/archiso \
            -maxdepth 8 -name vmlinuz-linux -type f 2>/dev/null | head -1) || true
        if [ -n "$vmlinux" ]; then
            local tree="$(dirname "$vmlinux")"
            # vmlinuz-linux is usually at <archisobasedir>/boot/<arch>/vmlinuz-linux
            # while airootfs.sfs is at <archisobasedir>/<arch>/airootfs.sfs.
            # Walk up until we find a directory that contains arch/<arch>/airootfs.sfs
            # or arch/<arch>/filesystem.squashfs nearby.
            while [ "$tree" != "/" ] && [ "$tree" != "$tree/.." ]; do
                for base in "${possible_sfs_basenames[@]}"; do
                    found=$(find "$tree" -maxdepth 4 -name "$base" -type f 2>/dev/null | head -1)
                    [ -n "$found" ] && { echo "$found"; return 0; }
                done
                tree="$(dirname "$tree")"
            done
        fi
    fi

    return 1
}

# ── 2. Find vmlinuz-linux ─────────────────────────────────────────────────

find_vmlinuz() {
    # Already at the expected path?
    [ -f "$EXPECTED_VMLINUZ" ] && { echo "$EXPECTED_VMLINUZ"; return 0; }

    local found="" search_root

    # If we found the squashfs, look for vmlinuz nearby first.
    if [ -n "${SFS_FOUND:-}" ]; then
        search_root=$(dirname "$SFS_FOUND")
        # Walk up to the ISO root (airootfs.sfs is usually at arch/x86_64/,
        # vmlinuz is at arch/boot/x86_64/ — go up a few levels).
        while [ "$search_root" != "/" ] && [ "$search_root" != "$search_root/.." ]; do
            found=$(find "$search_root" -maxdepth 5 -name "vmlinuz-linux" -type f 2>/dev/null | head -1)
            [ -n "$found" ] && { echo "$found"; return 0; }
            search_root=$(dirname "$search_root")
        done
    fi

    # Fall back to well-known mount points.
    for dir in /run/archiso/bootmnt /run/miso /run/media /mnt /media /run/archiso; do
        [ -d "$dir" ] || continue
        found=$(find "$dir" -maxdepth 6 -name "vmlinuz-linux" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done

    # Check every mounted filesystem.
    while read -r _ mountpoint _ _ _ _; do
        case "$mountpoint" in
            /proc|/sys|/dev|/run/udev|/run/lock|/tmp) continue ;;
        esac
        [ -d "$mountpoint" ] || continue
        found=$(find "$mountpoint" -maxdepth 6 -name "vmlinuz-linux" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done < /proc/mounts

    return 1
}

# ── 3. Create the expected paths ──────────────────────────────────────────

place_file() {
    local src="$1" dest="$2"
    if [ -f "$dest" ]; then
        log "already exists: $dest"
        return 0
    fi
    [ -f "$src" ] || return 1
    mkdir -p "$(dirname "$dest")"
    # Use a hard link when possible (works across the same filesystem and
    # avoids dangling symlink issues); fall back to symlink.
    if ln "$src" "$dest" 2>/dev/null; then
        log "linked $dest -> $src"
    elif ln -sf "$src" "$dest" 2>/dev/null; then
        log "symlinked $dest -> $src"
    else
        # Last resort: copy the file.
        cp -f "$src" "$dest" && log "copied $dest <- $src"
    fi
}

SFS_FOUND=""
SFS_FOUND=$(find_sfs) || true

if [ -z "$SFS_FOUND" ]; then
    log "ERROR: airootfs.sfs not found anywhere on the running system"
    log "       unpackfs will now try its own fallback paths (optional entries in"
    log "       unpackfs.conf), so this is not automatically fatal."
    log ""
    log "       If you wrote this ISO with dd, make sure you wrote the WHOLE device"
    log "       (e.g. /dev/sdX, not /dev/sdX1) and ran 'sync' afterwards."
    log "       If the USB is smaller than the ISO, the end of the squashfs may be"
    log "       truncated and this ISO cannot be used on that device."
    log "       If you used Ventoy, this ISO should still boot from the Ventoy menu;"
    log "       if it does not, the ISO may not be loopboot-compatible on this system."
    log ""
    log "       The installer's log (Calamares -> Log) will show the full"
    log "       fix-boot-media output above. If unpackfs then fails, the missing"
    log "       squashfs is the most likely cause."
    exit 0   # non-fatal: let unpackfs try its own fallback entries
fi

log "found airootfs.sfs at $SFS_FOUND"

# If fix-boot-media found the squashfs but it doesn't look readable, warn early.
# A truncated dd write often leaves a file that exists but fails to unsquash.
if command -v unsquashfs >/dev/null 2>&1; then
    if ! unsquashfs -l "$SFS_FOUND" >/dev/null 2>&1; then
        log "WARNING: airootfs.sfs exists but unsquashfs cannot read its index."
        log "         This usually means the ISO was not written correctly (truncated"
        log "         dd write, missing sync, incompatible device, or a non-hybrid image)."
    fi
fi

place_file "$SFS_FOUND" "$EXPECTED_SFS"

VMLINUXINUZ_FOUND=""
VMLINUXINUZ_FOUND=$(find_vmlinuz) || true
if [ -n "$VMLINUXINUZ_FOUND" ]; then
    log "found vmlinuz-linux at $VMLINUXINUZ_FOUND"
    place_file "$VMLINUXINUZ_FOUND" "$EXPECTED_VMLINUZ"
else
    log "WARNING: vmlinuz-linux not found (packages step will install the kernel)"
fi

exit 0
